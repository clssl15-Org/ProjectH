  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>1. \uC138\uACC4\uC758 \uAE30\uC6D0</b>\n\n- \uC138\uACC4\uB294 <b>\uBE5B\uACFC
    \uC5B4\uB460\uC758 \uADE0\uD615</b> \uC704\uC5D0 \uC138\uC6CC\uC84C\uB2E4.\r\n-
    <b>\uBE5B\uC758 \uC218\uD638\uC790</b>\uB294 \uC9C0\uC0C1\uC744, <b>\uC5B4\uB460\uC758
    \uC218\uD638\uC790</b>\uB294 \uC9C0\uD558 \uC138\uACC4\uB97C \uB2E4\uC2A4\uB9AC\uBA70
    \uADE0\uD615\uC744 \uC720\uC9C0\uD588\uB2E4.\r\n- \uB0AE\uC5D0\uB294 \uC778\uAC04\uC774
    \uBC88\uC601\uD558\uACE0, \uC5B4\uB460\uC774 \uB4DC\uB9AC\uC6B0\uB294 \uBC24\uC774
    \uB418\uBA74 \uC9C0\uD558\uC5D0\uC11C \uC5B4\uB460\uC758 \uC874\uC7AC\uB4E4\uC774
    \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0C8\uB2E4.\r\n- \uC778\uAC04\uB4E4\uC740 \uC138\uC0C1\uC744
    \uC9C0\uD0A4\uAE30 \uC704\uD574 <b>\uAE30\uC0AC\uB2E8</b>\uC744 \uC870\uC9C1\uD588\uACE0,
    \uB9E4\uC77C \uBC24 \uC5B4\uB460\uC758 \uBAAC\uC2A4\uD130\uC640 \uC2F8\uC6B0\uBA70
    \uC138\uACC4\uC758 \uADE0\uD615\uC744 \uC9C0\uCF1C\uC654\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0ea255a10bfc42c4bab5baf549370a48, type: 2}
