--- !u!114 &5974788677460830716
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4887330522029843449}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>2. \uADE0\uC5F4\uC758 \uC2DC\uC791</b>\n\n- \uB8E8\uBA58\uAC00\uB974\uB4DC\uC758
    \uC655\uC790 <b>\uC138\uB9AC\uC628</b>\uC740 \uB05D\uC5C6\uB294 \uC804\uC7C1\uC5D0
    \uC9C0\uCCD0 \uC788\uC5C8\uB2E4.\r\n- \uADF8\uB294 \u201C\uC9C4\uC815\uD55C \uD3C9\uD654\uB294
    \uC5B4\uB460\uC744 \uBC1B\uC544\uB4E4\uC774\uB294 \uAC83\u201D\uC774\uB77C\uB294
    \uC720\uD639\uC5D0 \uC774\uB04C\uB824, <b>\uC5B4\uB460\uC758 \uC218\uD638\uC790
    \uBCA8\uB9AC\uC544</b>\uC640 \uC811\uCD09\uD588\uB2E4.\r\n- \uADF8 \uD798\uC5D0
    \uB9E4\uD639\uB41C \uC138\uB9AC\uC628\uC740 \uC810\uCC28 \uBE5B\uC758 \uC2E0\uB150\uC744
    \uC783\uACE0, <b>\uC5B4\uB460\uC5D0 \uC7A0\uC2DD\uB41C \uC874\uC7AC</b>\uB85C
    \uBCC0\uD574\uAC14\uB2E4.\r\n- \uACB0\uAD6D \uADF8\uB294 \uC644\uC804\uD788 \uD0C0\uB77D\uD574
    <b>\uC554\uD751\uC758 \uC138\uB9AC\uC628</b>\uC73C\uB85C \uBD88\uB9AC\uAC8C \uB418\uC5C8\uACE0,
    \uADF8 \uC21C\uAC04 \uB8E8\uBA58\uAC00\uB974\uB4DC\uB294 <b>\uB05D\uC5C6\uB294
    \uBC24</b>\uC5D0 \uD729\uC2F8\uC600\uB2E4.\r\n- \uBE5B\uACFC \uC5B4\uB460\uC758
    \uADE0\uD615\uC774 \uBB34\uB108\uC9C8 \uB54C, \uBE5B\uC758 \uC218\uD638\uC790\uAC00
    \uC5B4\uB460\uC5D0 \uD729\uC2F8\uC5EC \uD615\uD0DC\uAC00 \uBD95\uAD34\uB418\uC5C8\uB2E4.\n 
    \uADF8\uB7EC\uB098 \uC644\uC804\uD788 \uD0C0\uB77D\uD558\uC9C0 \uC54A\uC558\uACE0,
    \uC791\uC740 \uC545\uB9C8\uC758 \uBAA8\uC2B5\uC73C\uB85C \uB5A8\uC5B4\uC838 \uB098\uC654\uB2E4.\r
    \n  \uADF8\uAC83\uC774 \uBC14\uB85C <b>\uB8E8\uBE44\uC5D8</b>\uC774\uC5C8\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0ea255a10bfc42c4bab5baf549370a48, type: 2}
