  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>3. \uC138\uACC4\uC758 \uBD95\uAD34</b>\n\n- \uC138\uB9AC\uC628\uC758
    \uD0C0\uB77D\uC73C\uB85C <b>\uB8E8\uBA58\uAC00\uB974\uB4DC \uC655\uAD6D\uC740
    \uBA78\uB9DD</b>\uD588\uB2E4.\r\n- \uBE5B\uC758 \uC218\uD638\uC790\uB4E4\uC740
    \uD798\uC744 \uC783\uACE0 \uD558\uB098\uB458 \uC0AC\uB77C\uC84C\uC73C\uBA70,
    \uAE30\uC0AC\uB2E8\uC740 \uB05D\uB0B4 \uBB34\uB108\uC84C\uB2E4.\r\n  \uC138\uC0C1\uC740
    \uC5B4\uB460\uC5D0 \uC7A0\uC2DD\uB418\uC5C8\uB2E4.\r\n- \uADF8\uB7EC\uB098 \uC778\uAC04\uC774
    \uC644\uC804\uD788 \uC0AC\uB77C\uC9C4 \uAC83\uC740 \uC544\uB2C8\uC5C8\uB2E4.\r\n 
    \uC77C\uBD80\uB294 <b>\uBE5B\uC758 \uACB0\uC815</b>\uC744 \uC774\uC6A9\uD574
    \uC2A4\uC2A4\uB85C \uBE5B\uC744 \uB9CC\uB4E4\uC5B4\uB0B4\uBA70 \uC0B4\uC544\uB0A8\uC558\uB2E4.\r\n 
    \uADF8\uB4E4\uC740 \uBE5B\uC744 \uBAA8\uC544 \uB9CC\uB4E0 \uAC70\uB300\uD55C
    \uBC29\uC5B4 \uACB0\uACC4 \uB3C4\uC2DC \u2018<b>\uBE5B\uC758 \uB9C8\uC744</b>\u2019\uC5D0
    \uBAA8\uC5EC \uC0B4\uC558\uB2E4.\r\n  \uC778\uAC04\uB4E4\uC740 \u2018<b>\uBE5B\uC758\uB9C8\uC744</b>\u2019\uC744
    \uC911\uC2EC\uC73C\uB85C, \uC5B4\uB460 \uC18D\uC5D0\uC11C \uC0DD\uBA85\uC744
    \uC774\uC5B4\uAC00\uACE0 \uC788\uB2E4.\r\n- \uB8E8\uBA58\uAC00\uB974\uB4DC\uC758
    \uC911\uC2EC\uC5D0 \uC788\uB358 \u2018<b>\uB8E8\uBA58\uBCA8 \uC131</b>\u2019\uC740
    \uC655\uAD6D\uC758 \uC0C1\uC9D5\uC774\uC5C8\uB2E4. \n  \uD55C\uB54C \uBE5B\uC758
    \uC218\uD638\uC790\uC758 \uD798\uC774 \uAE43\uB4E0 <b>\uC131\uC2A4\uB7EC\uC6B4
    \uC694\uC0C8</b>\uC600\uC73C\uB098, \uC9C0\uAE08\uC740 <b>\uC5B4\uB460\uC758
    \uC655\uC88C</b>\uB85C \uBCC0\uC9C8\uB418\uC5C8\uB2E4.\r\n- \uADF8\uACF3\uC740
    \uC774\uC81C <b>\uC138\uACC4\uC758 \uADE0\uC5F4\uC774 \uAC00\uC7A5 \uC9D9\uC740
    \uC7A5\uC18C</b>, \uADF8\uB9AC\uACE0 <b>\uBAA8\uB4E0 \uC5B4\uB460\uC758 \uADFC\uC6D0</b>\uC73C\uB85C
    \uB0A8\uAC8C \uB41C\uB2E4."
