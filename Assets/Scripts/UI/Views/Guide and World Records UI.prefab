  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>4. Last Lumen Knight</b>\n\n- \uC138\uC0C1\uC774 \uC5B4\uB460\uC5D0
    \uC7A0\uC2DD\uB41C \uC9C0 <b>100\uB144</b>.\r\n- \uB9C8\uC9C0\uB9C9 \uC804\uD22C\uC5D0\uC11C
    \uC804\uC0AC\uD55C \uD55C \uBE5B\uC758 \uAE30\uC0AC\uC758 \uC601\uD63C\uC774
    \uC232 \uC18D \uAE4A\uC740 \uACF3\uC5D0 \uC7A0\uB4E4\uC5B4 \uC788\uC5C8\uB2E4.\r\n-
    \uADF8\uB97C \uAE68\uC6B4 \uC874\uC7AC\uB294 <b>\uB8E8\uBE44\uC5D8,</b> \uBE5B\uC758
    \uC218\uD638\uC790\uC758 \uC794\uC7AC\uC774\uC790 \uC5B4\uB460\uC5D0 \uBB3C\uB4E0
    \uC874\uC7AC\uC600\uB2E4.\r\n- \uB8E8\uBE44\uC5D8\uC740 \uC790\uC2E0\uC758 \uB0A8\uC740
    \uBE5B\uC744 \uAE43\uB4E4\uC5EC, <b>\uB9C8\uC9C0\uB9C9 \uBE5B\uC758 \uAE30\uC0AC</b>\uB97C
    \uB2E4\uC2DC \uBD80\uD65C\uC2DC\uCF30\uB2E4.\r\n- \uAE30\uC0AC\uB294 \uC138\uC0C1\uC744
    \uB2E4\uC2DC \uADE0\uD615\uC73C\uB85C \uB418\uB3CC\uB9B4 \uB9C8\uC9C0\uB9C9 \uD76C\uB9DD\uC73C\uB85C
    \uAE68\uC5B4\uB09C\uB2E4.\r\n- \uC624\uB798\uB41C \uC131\uCC44\uC640 \uD3D0\uD5C8\uC5D0\uB294
    \uACFC\uAC70 <b>\uAE30\uC0AC\uB2E8\uC758 \uC720\uBB3C</b>\uC774 \uB0A8\uC544
    \uC788\uB2E4.\r\n  \uBE5B\uC758 \uAC80, \uCC22\uAE34 \uAE43\uBC1C, \uADF8\uB9AC\uACE0
    \uC78A\uD78C \uAE30\uC5B5\uB4E4\uC774 \uC774\uACF3\uC800\uACF3\uC5D0\uC11C \uC190\uAE38\uC744
    \uAE30\uB2E4\uB9B0\uB2E4.\r\n- \uADF8\uC758 \uC5EC\uC815\uC740 <b>\uBE5B\uC758
    \uB9C8\uC744</b>\uC5D0\uC11C \uC2DC\uC791\uB418\uC5B4, \uACB0\uAD6D <b>\uB8E8\uBA58\uBCA8
    \uC131</b>\uC5D0 \uB3C4\uCC29\uD55C\uB2E4.\r\n- <b>\uC554\uD751\uC758 \uC138\uB9AC\uC628\uACFC
    \uBCA8\uB9AC\uC544</b>\uAC00 \uB9C8\uC9C0\uB9C9 \uAE30\uC0AC\uB97C \uAE30\uB2E4\uB9AC\uACE0
    \uC788\uB2E4.\r\n- \uC774 \uC138\uACC4\uC758 \uC6B4\uBA85\uC740, \uC774\uC81C
    \uB2F9\uC2E0\uC758 \uC190\uC5D0 \uB2EC\uB824 \uC788\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0ea255a10bfc42c4bab5baf549370a48, type: 2}
