  _lines:
  - Character: 4
    Dialogue: "..\uADF8 \uC5BC\uAD74. \uC624\uB79C\uB9CC\uC774\uAD70."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "\uC5ED\uC2DC \uB124\uAC00 \uC62C \uC904 \uC54C\uC558\uB2E4, \uAE30\uC0AC."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "\uB10C\u2014"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 3
    Dialogue: "\uC544\uC9C1\uB3C4 \uBE5B\uC744 \uBD99\uC7A1\uACE0 \uC788\uB124."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 3
    Dialogue: "\uADF8 \uC870\uAC01\uAE4C\uC9C0 \uB370\uB9AC\uACE0 \uC640\uC11C."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\u2026\u2026"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "\uB8E8\uBE44\uC5D8. \uADF8 \uBAA8\uC2B5\uC740 \uC2E0\uAE30\uD558\uAD70."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "\uC774\uC81C \uADF8\uB9CC \uBC1B\uC544\uB4E4\uC774\uB294 \uAC8C \uC5B4\uB54C."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uB10C\u2026 \uC608\uC804\uC758 \uB124\uAC00 \uC544\uB2C8\uC57C."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "\uB108\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uC778 \uAC83 \uAC19\uC740\uB370,
      \uB8E8\uBE44\uC5D8."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 3
    Dialogue: "\uBAA8\uB4E0 \uAC74 \uC774\uBBF8 \uBB34\uB108\uC84C\uC5B4."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 3
    Dialogue: "\uADF8\uB7F0\uB370\uB3C4 \uC544\uC9C1 \uB418\uB3CC\uB9B4 \uC218 \uC788\uB2E4\uACE0
      \uBBFF\uC5B4?"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "\u2026\u2026"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "\uC9C0\uAE08\uC774\uB77C\uB3C4 \uBC1B\uC544\uC904 \uC218 \uC788\uB2E4.
      \uB108\uD76C \uB458 \uB2E4."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "\uC798 \uC0DD\uAC01\uD574\uBD10."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "\uCDA9\uBD84\uD788 \uB4E4\uC5C8\uB2E4. \uC900\uBE44\uD574\uB77C."
