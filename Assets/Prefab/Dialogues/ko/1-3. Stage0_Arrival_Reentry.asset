  _targetStyle: 2
  _lines:
  - Character: 2
    Dialogue: "\uC774\uBC88\uC5D4 \uB8E8\uBA58\uBCA8 \uCABD\uC73C\uB85C \uB354 \uAC14\uC5C8\uC9C0?\n\u2026\uC870\uC2EC\uD574."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uC544\u2026 \uC544\uC9C1 \uAE30\uC5B5 \uBABB \uD558\uB294\uAD6C\uB098.\n\uAD1C\uCC2E\uC544.\n\uB2E4\uC2DC
      \uC2DC\uC791\uD558\uBA74 \uB3FC."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uBC8C\uC368 \uC801\uC751\uD588\uB124."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uC774\uBC88\uC5D4 \uC880 \uB354 \uBE68\uB77C\uC84C\uC5B4."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uB108\u2026 \uC8FD\uB294 \uAC70, \uC774\uC81C \uC775\uC219\uD574\uC84C\uC9C0?"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uC774\uC81C \uB0B4\uAC00 \uB9D0 \uC548 \uD574\uB3C4 \uC54C\uACA0\uC9C0."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uC774\uBC88\uC774\u2026 \uBA87 \uBC88\uC9F8\uC600\uB354\uB77C."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
