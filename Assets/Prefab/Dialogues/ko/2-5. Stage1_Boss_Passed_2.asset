  _title: Stage1_Boss_Passed_2
  _language: 2
  _showOneRandomLine: 0
  _targetStyle: 1
  _lines:
  - Character: 1
    Dialogue: "\uBC29\uAE08 \uADF8\uAC74\u2026 \uBB50\uC600\uC9C0?"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uD3D0\uD5C8\uC758 \uC232\uC5D0 \uB0A8\uC740 \uC0DD\uBA85\uCCB4\uC57C.
      \n\uC5B4\uB460\uC5D0 \uBA39\uD600\uC11C, \uC6D0\uB798 \uBAA8\uC2B5\uC740 \uAC70\uC758
      \uC5C6\uC5B4."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uB8E8\uBA58\uAC00\uB974\uB4DC\uC758 \uC655\uC790\uAC00 \uBB34\uB108\uC9C4
      \uB4A4, \uC774 \uC232\uB3C4 \uD568\uAED8 \uB4A4\uD2C0\uB838\uC5B4."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "\uC655\uC790?"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uC138\uB9AC\uC628."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uB8E8\uBA58\uAC00\uB974\uB4DC\uC758 \uB9C8\uC9C0\uB9C9 \uC655\uC790\uC57C."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "\uADF8\uAC00\u2026 \uC774 \uBAA8\uB4E0 \uAC78?"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uC544\uC9C1\uC740 \uADF8\uB807\uAC8C\uB9CC \uC54C\uC544\uB46C. \uC9C0\uAE08\uC740,
      \uC55E\uC73C\uB85C \uB098\uC544\uAC00\uB294 \uAC8C \uBA3C\uC800\uC57C."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
