  m_Script: {fileID: 11500000, guid: 3a6d80d382855614687768576cf39b77, type: 3}
  m_Name: 1-7. Stage0_TownPortal
  m_EditorClassIdentifier: 
  _title: Stage0_TownPortal
  _showOneRandomLine: 0
  _targetStyle: 1
  _lines:
  - Character: 1
    Dialogue: "\uB9CC\uC57D \uB0B4\uAC00 \uC8FD\uC73C\uBA74\u2026 \uC5B4\uB5BB\uAC8C
      \uB418\uC9C0?"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uB2E4\uC2DC \uC5EC\uAE30\uB85C \uB3CC\uC544\uC640."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "\u2026\uC5EC\uAE30?"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uC774 \uB9C8\uC744\uC5D0 \uB0B4\uAC00 \uC2DC\uAC04\uC744 \uBB36\uC5B4
      \uB1A8\uAC70\uB4E0."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uB124 \uC601\uD63C\uC5D4 \uBE5B\uC758 \uC778\uC7A5\uC774 \uC0C8\uACA8\uC838
      \uC788\uC5B4."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uBD80\uC11C\uC9C8 \uB54C\uAE4C\uC9C0, \uBA87 \uBC88\uC774\uB4E0."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "\uC9C0\uAE08 \uB0B4\uAC00 \uBA87 \uBC88\uC774\uB098 \uC8FD\uC5C8\uC9C0?"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uBAB0\uB77C."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uC138\uB294 \uAC74, \uB108\uBCF4\uB2E4 \uB0B4\uAC00 \uBA3C\uC800
      \uD3EC\uAE30\uD588\uC5B4."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uADF8\uB798\uB3C4 \uBAA9\uC801\uC9C0\uB294 \uD558\uB098\uC57C."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "\uB8E8\uBA58\uBCA8 \uC131\uC73C\uB85C \uAC00\uC790"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
