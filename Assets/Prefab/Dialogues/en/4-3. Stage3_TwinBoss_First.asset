  m_Script: {fileID: 11500000, guid: 3a6d80d382855614687768576cf39b77, type: 3}
  m_Name: 4-3. Stage3_TwinBoss_First
  m_EditorClassIdentifier: 
  _title: Stage3_TwinBoss_First
  _language: 3
  _showOneRandomLine: 0
  _targetStyle: 1
  _lines:
  - Character: 4
    Dialogue: "..That face. It has been a long time."
    _overrides:
      Name: "Therion"
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "I knew you would come, Knight."
    _overrides:
      Name: "Therion"
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "You—"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 3
    Dialogue: "Still clinging to the light, I see."
    _overrides:
      Name: "Velia"
      Portrait: {fileID: 0}
  - Character: 3
    Dialogue: "Even bringing that fragment along with you."
    _overrides:
      Name: "Velia"
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "……"
    _overrides:
      Name: "Rubiel"
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "Rubiel. That appearance is quite curious."
    _overrides:
      Name: "Therion"
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "Why not just accept it by now?"
    _overrides:
      Name: "Therion"
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "You… are not the person you used to be."
    _overrides:
      Name: "Rubiel"
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "I believe the same could be said for you, Rubiel."
    _overrides:
      Name: "Therion"
      Portrait: {fileID: 0}
  - Character: 3
    Dialogue: "Everything has already fallen apart."
    _overrides:
      Name: "Velia"
      Portrait: {fileID: 0}
  - Character: 3
    Dialogue: "Do you honestly believe it can still be undone?"
    _overrides:
      Name: "Velia"
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "……"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "I can still welcome you even now. Both of you."
    _overrides:
      Name: "Therion"
      Portrait: {fileID: 0}
  - Character: 4
    Dialogue: "Think carefully."
    _overrides:
      Name: "Therion"
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "I have heard enough. Draw your weapon."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
