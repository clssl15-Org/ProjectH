  m_Name: 1-100. Ending_Arrival
  m_EditorClassIdentifier: 
  _title: Ending_Arrival
  _language: 3
  _showOneRandomLine: 0
  _targetStyle: 1
  _lines:
  - Character: 2
    Dialogue: "……It is over."
    _overrides:
      Name: "Rubiel"
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "Is it finally… safe now?"
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "Yes."
    _overrides:
      Name: "Rubiel"
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "The frozen time is flowing once again."
    _overrides:
      Name: "Rubiel"
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "I can feel it… the light, the wind."
    _overrides:
      Name: "Rubiel"
      Portrait: {fileID: 0}
  - Character: 1
    Dialogue: "I see."
    _overrides:
      Name: 
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "Let us return to the village of light."
    _overrides:
      Name: "Rubiel"
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "…This time, we will not be coming back."
    _overrides:
      Name: "Rubiel"
      Portrait: {fileID: 0}
