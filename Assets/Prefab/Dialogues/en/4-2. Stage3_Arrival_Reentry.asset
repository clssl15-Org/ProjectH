      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "Don't stay too long."
    _overrides:
      Name: "Rubiel"
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "My power weakens here."
    _overrides:
      Name: "Rubiel"
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "Let's go. Not much left, {player}."
    _overrides:
      Name: "Rubiel"
      Portrait: {fileID: 0}
  - Character: 2
    Dialogue: "…No time to hesitate."
    _overrides:
      Name: "Rubiel"
